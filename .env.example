# ─────────────────────────────────────────────────────────────
#  Copia este archivo como ".env" si quieres cambiar algo.
#  Si no creas ".env", la app funciona igual con estos valores.
# ─────────────────────────────────────────────────────────────

# Clave para entrar al panel /admin (candado de demostración)
VITE_ADMIN_PIN=masfacil

# Dónde se guardan las respuestas: "local" (navegador) o "supabase"
VITE_DATA_SOURCE=local

# Para más adelante (cuando conectemos Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
